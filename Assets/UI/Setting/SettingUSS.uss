/* Thiết lập lớp nền mờ toàn màn hình, căn giữa Popup */
.screen-overlay {
    flex-grow: 1;
    background-color: rgba(15, 23, 42, 0.65); /* Màu nền tối trong suốt */
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* Khung Popup chính */
.settings-container {
    background-color: #1e293b; /* Màu nền Slate tối hiện đại */
    border-width: 2px;
    border-color: #38bdf8; /* Viền màu xanh Neon nhẹ */
    border-radius: 12px;
    padding: 24px;
    width: 450px;
    min-height: 350px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
}

/* Style cho Tiêu đề */
.header-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #f8fafc;
    text-align: center;
    letter-spacing: 2px;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-color: #475569;
    padding-bottom: 10px;
}

/* Thân bảng cài đặt chứa các hàng */
.settings-body {
    flex-grow: 1;
    margin-bottom: 20px;
}

/* Định dạng Flexbox cho mỗi hàng Cài đặt (Label bên trái, Slider bên phải) */
.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-vertical: 8px;
    padding-horizontal: 4px;
}

/* Chữ nhãn bên trái */
.setting-label {
    font-size: 14px;
    color: #cbd5e1;
    width: 140px;
}

/* Thanh kéo Slider bên phải */
.setting-slider {
    flex-grow: 1;
    margin: 0;
}

/* Custom lại thanh Slider mặc định của UI Toolkit cho đẹp hơn */
.setting-slider .unity-base-slider__tracker {
    background-color: #475569;
    border-radius: 4px;
    height: 8px;
}

.setting-slider .unity-base-slider__dragger {
    background-color: #0ea5e9;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    margin-top: -4px;
}

/* Định dạng nút Close */
.btn-close {
    background-color: #ef4444; /* Màu đỏ nổi bật */
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    border-radius: 6px;
    border-width: 0;
    padding-vertical: 10px;
    width: 100%;
    transition-property: background-color;
    transition-duration: 0.15s;
}

/* Hiệu ứng khi di chuột hoặc nhấn nút */
.btn-close:hover {
    background-color: #dc2626;
}

.btn-close:active {
    background-color: #b91c1c;
}