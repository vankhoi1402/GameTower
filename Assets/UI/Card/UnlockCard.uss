.overlay
{
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    justify-content: center;
    align-items: center;

    background-color: rgba(0,0,0,0.75);
    
}

.card
{
    width: 450px;

    background-color: rgb(40,40,40);

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;

    align-items: center;

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.title
{
    font-size: 24px;

   /*  unity-font-style: bold; */

    margin-bottom: 15px;

    color: yellow;
}

.chapter-icon
{
    width: 128px;
    height: 128px;

    margin-bottom: 10px;

    background-size: contain;
    background-repeat: no-repeat;
}

.chapter-name
{
    font-size: 22px;

   /*  unity-font-style: bold; */

    color: white;
}

.chapter-description
{
    font-size: 16px;

    color: white;

    margin-top: 10px;
    margin-bottom: 20px;
}

.reward-title
{
    font-size: 18px;

    color: yellow;
}

.reward-icon
{
    width: 96px;
    height: 96px;

    margin-top: 10px;

    background-size: contain;
    background-repeat: no-repeat;
}

.reward-name
{
    font-size: 18px;

    color: white;

    margin-top: 10px;
    margin-bottom: 20px;
}

.confirm-button
{
    width: 180px;
    height: 45px;
}
