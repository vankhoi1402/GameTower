<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
   <Style src="ForSystem.uss"/>
    <ui:VisualElement name="MainContainer" style="flex-grow: 1; justify-content: flex-end; align-items: center;">
        <ui:VisualElement name="Inventory" style="flex-direction: row; background-color: rgba(0, 0, 0, 0.5); padding: 10px; border-radius: 10px; margin-bottom: 20px;">
            <!-- Các Icon quân lính -->
            <ui:VisualElement name="Archer" class="unit-icon" />
            <ui:VisualElement name="Warrior" class="unit-icon" />
            <ui:VisualElement name="Tank" class="unit-icon" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>