.root-style {
    flex-grow: 1;
    width: 100%;
    height: 100%;
  
    
    flex-direction: column;
}
#root-container{
    width: 100%;
    height: 100%; 
}

.grid-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.exit-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 52px;
    height: 52px;
    font-size: 20px;
    background-color: rgba(180, 40, 40, 0.95);
    color: white;
    border-radius: 12px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
}

.exit-button:hover {
    background-color: rgb(220, 60, 60);
}

#bottom-ui {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;  
}

.ready-button {
    width: 220px;
    height: 56px;
    margin-bottom: 14px;
    font-size: 22px;
    background-color: rgba(40, 170, 90, 0.95);
    color: white;
    border-radius: 14px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
}

.ready-button:hover {
    background-color: rgb(60, 200, 110);
}

.inventory-bar {
    width: 100%;
    height: 120px;
    background-color: rgba(15, 20, 30, 0.88);
    border-top-width: 2px;
    border-top-color: rgba(100, 200, 255, 0.4);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.unit-button {
    width: 96px;
    height: 96px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
}

.unit-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(100, 200, 255, 0.35);
    border-bottom-color: rgba(100, 200, 255, 0.35);
    border-left-color: rgba(100, 200, 255, 0.35);
    border-right-color: rgba(100, 200, 255, 0.35);
}

.grid-cell {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.02);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.04);
    border-right-color: rgba(255, 255, 255, 0.04);
    border-top-color: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    transition-property: background-color, border-color;
    transition-duration: 0.08s;
}

.grid-cell:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
}
